# Dev-only non-real secrets for local Postgres + PostgREST. NOT for production.
# Production secrets come from a real secret manager (Vault, AWS SM, Doppler, etc.).
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=postgres
# JWT_SECRET is the dev-only HMAC secret shared by PostgREST for token validation.
# In a Supabase Cloud project this would be a real 32+ byte random string managed by Vault.
JWT_SECRET=dev-only-do-not-use-in-prod-0001-0000-0000-0000-000000000abc
