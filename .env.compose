# Dev-only non-real secrets for local Postgres + GoTrue + Realtime + Meta + PostgREST.
# NOT for production. Production secrets come from a real secret manager
# (Vault, AWS SM, Doppler, etc.). This file is committed on purpose because
# every value here is a dev-only literal — none are real credentials.
#
# JWT_SECRET is the dev-only HMAC secret shared by PostgREST, GoTrue,
# Realtime, and Meta. Any service that validates a JWT reads this same
# literal. In Supabase Cloud this is a real 32+ byte random string from Vault.
JWT_SECRET=dev-only-do-not-use-in-prod-0001-0000-0000-0000-000000000abc

# ANON_KEY and SERVICE_ROLE_KEY are HS256 JWTs signed with JWT_SECRET.
# They are public keys (their trust is anchored in JWT_SECRET); NOT secrets.
# Regenerated deterministically by scripts/gen-keys.js on every db:reset.
# Placeholder values below are replaced by the first db:reset run.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzkwNzEyMzIzLCJleHAiOjIxMDYwNzIzMjN9.-DJVzX-_uEcJS0l5cRs5uSA_NkJrMtWphirTeh6wjPM
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3OTA3MTIzMjMsImV4cCI6MjEwNjA3MjMyM30.gaynQVdbaRygV7GKwT5y0MSi6ryPGcR7uGhK56vJKxE

# JWT_SECRET alias for GoTrue (GoTrue reads GOTRUE_JWT_SECRET, not JWT_SECRET).
GOTRUE_JWT_SECRET=dev-only-do-not-use-in-prod-0001-0000-0000-0000-000000000abc

# JWT_SECRET alias for Meta's metrics endpoint.
METRICS_JWT_SECRET=dev-only-do-not-use-in-prod-0001-0000-0000-0000-000000000abc

# GoTrue cookie encryption — independent random string (dev-only).
SECRET_KEY_BASE=dev-only-do-not-use-in-prod-secret-key-base-0000-0000-0000-abc

# DATABASE_URL — GoTrue, Realtime, Meta all reach the same Postgres container.
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres

# API_EXTERNAL_URL — GoTrue and Realtime broadcast this for redirect/callback.
API_EXTERNAL_URL=http://gateway:54321

# Postgres / PostgREST (kept here so docker-compose can reference them uniformly).
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=postgres
