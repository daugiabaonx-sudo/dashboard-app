# Dev-only non-real secrets for local Supabase stack. NOT for production.
# Production secrets come from a real secret manager (Vault, AWS SM, Doppler, etc.).
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=postgres
JWT_SECRET=dev-only-do-not-use-in-prod-0001-0000-0000-0000-000000000abc
GOTRUE_JWT_SECRET=dev-only-do-not-use-in-prod-0001-0000-0000-0000-000000000abc
PGRST_JWT_SECRET=dev-only-do-not-use-in-prod-0001-0000-0000-0000-000000000abc
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_URI_ALLOW_LIST=http://localhost:3000
GOTRUE_DISABLE_SIGNUP=false
STORAGE_BACKEND=file
REALTIME_DB_POOL_URL=postgres://postgres:postgres@db:5432/postgres