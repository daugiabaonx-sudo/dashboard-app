# Phase E — Supabase environment variables.
# Copy this file to `.env.local` and fill in real values (or leave MOCK_SUPABASE=1 for in-memory mode).

# When MOCK_SUPABASE=1, the app uses an in-memory adapter (no real DB).
# Useful when Docker is unavailable. RLS and realtime will NOT be exercised.
MOCK_SUPABASE=1

# Supabase project URL (e.g. http://127.0.0.1:54321 for local Docker, or https://xxx.supabase.co for cloud).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key (safe to expose to client — protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=mock-anon-key-replace-me

# Server-only service role key (NEVER expose to client; bypasses RLS for admin operations).
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-replace-me

# Active workspace cookie name. Defaults to "sunext.active_workspace".
ACTIVE_WORKSPACE_COOKIE=sunext.active_workspace

## Phase F — full local Supabase stack via docker-compose.
## After `npm run db:reset` brings compose up + scripts/seed-auth.js finishes,
## paste the keys it prints below and set MOCK_SUPABASE=0.
# GOTRUE_URL=http://127.0.0.1:9999
# REALTIME_URL=http://127.0.0.1:4000
# REST_URL=http://127.0.0.1:3001
