# Phase F — Supabase environment variables.
# Copy this file to `.env.local` and fill in real values from the
# `npm run db:stack` banner. The default below points at the local
# docker-compose stack; set MOCK_SUPABASE=1 to fall back to the in-memory
# mock if Docker isn't available.

# When MOCK_SUPABASE=1, the app uses an in-memory adapter (no real DB).
# Useful when Docker is unavailable. RLS and realtime will NOT be exercised.
# This is the one-flag rollback from real mode — flip to 1 and the app
# returns to mock without any code changes.
#
# NEXT_PUBLIC_MOCK_SUPABASE is the client-side mirror. Browsers can't read
# server-only env vars, so the client bundle must opt into mock mode
# explicitly. Keep both flags in sync (one source of truth: MOCK_SUPABASE).
MOCK_SUPABASE=0
NEXT_PUBLIC_MOCK_SUPABASE=0

# Supabase project URL.
#
# Production: https://<project-ref>.supabase.co (Cloud Supabase).
# Local dev:  http://127.0.0.1:54321 (Caddy gateway in front of GoTrue,
#             Realtime, PostgREST, Meta via docker-compose).
#
# The local gateway mirrors Cloud's path layout (/auth/*, /realtime/*,
# /meta/*, default → /rest) so the same code paths work in both modes.
# For prod deploys, replace the URL below with the Cloud project URL.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Local-dev override (uncomment for `npm run db:stack`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key (safe to expose to client — protected by RLS).
# Copy ANON_KEY from the banner printed by `npm run db:stack`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-db:stack-banner

# Server-only service role key (NEVER expose to client; bypasses RLS for
# admin operations). Copy SERVICE_ROLE_KEY from the same banner.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-db:stack-banner

# Active workspace cookie name. Defaults to "sunext.active_workspace".
ACTIVE_WORKSPACE_COOKIE=sunext.active_workspace

# Quick start (production / Cloud):
#   1. Replace NEXT_PUBLIC_SUPABASE_URL with https://<project-ref>.supabase.co
#   2. Replace the ANON_KEY + SERVICE_ROLE_KEY placeholders with values
#      from the Supabase dashboard (Settings → API).
#   3. npm run dev                                # or: npm run build && npm run start
#
# Quick start (local docker-compose):
#   1. Uncomment the local override URL.
#   2. npm run db:stack                            # compose up + migrate + seed + seed-auth
#   3. Copy ANON_KEY + SERVICE_ROLE_KEY from the banner into the placeholders.
#   4. npm run dev
#
# Rollback:
#   MOCK_SUPABASE=1                             # returns to in-memory mock, no code change
